{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [ "${mod_authors}" ],
  "contact": {
    "homepage": "https://modrinth.com/mod/3d-maps",
    "sources": "https://github.com/Al-Capone11/3D-Maps",
    "issues": "https://github.com/Al-Capone11/3D-Maps/issues"
  },
  "license": "${mod_license}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [ "com.josem.threedmaps.fabric.ThreeDMapsFabric" ],
    "client": [ "com.josem.threedmaps.fabric.ThreeDMapsFabricClient" ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "${minecraft_version_range}",
    "java": ">=${java_version}"
  },
  "recommends": {
    "modmenu": "*"
  },
  "suggests": {
    "chunky": "*"
